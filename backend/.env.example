# DreamStay backend — copy to .env and fill in real values. Never commit .env.

# Port the API listens on (Render sets this automatically)
PORT=8080

# MongoDB connection string, including the database name
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>"

# Secret used to sign login tokens. Use a long random string; changing it signs everyone out.
SECRET_KEY="<long-random-secret>"

# AWS S3 credentials for hotel image uploads (access key id and secret access key)
AWS="<aws-access-key-id>"
AWS_SK="<aws-secret-access-key>"

# Public base URL images are served from (bucket URL or CDN), without a trailing slash
CLOUD_DOMAIN="https://<your-bucket-or-cdn-domain>"

# Gmail account used to send warning emails (use an app password, not the account password)
MAILER_ID="<you@gmail.com>"
MAILER_PASS="<gmail-app-password>"

# ── Optional (defaults shown) ──────────────────────────────────────────────
# AWS_REGION="ap-south-1"
# S3_BUCKET="projects012"

# LOCAL-ONLY: send uploads to local MinIO instead of AWS (docker-compose sets this). Leave unset in production.
# S3_ENDPOINT="http://localhost:9000"
